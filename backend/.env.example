# ============================================================================
# SQL Server Database Configuration
# ============================================================================
# Local Windows Express (pyodbc default):
# DB_SERVER=localhost\SQLEXPRESS
# DB_NAME=PotholeDetectionDB
# DB_TRUSTED_CONNECTION=yes
#
# Remote / Render via ngrok TCP tunnel (pymssql FreeTDS):
# DB_SERVER=0.tcp.ngrok.io
# DB_PORT=12345
# DB_NAME=PotholeDetectionDB
# DB_USER=pothole_app
# DB_PASSWORD=your_strong_password_here
# DB_TRUSTED_CONNECTION=no
#
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_PORT=
DB_NAME=PotholeDetectionDB
DB_TRUSTED_CONNECTION=yes
DB_USER=
DB_PASSWORD=


# ============================================================================
# Flask Application Configuration
# ============================================================================
FLASK_APP=wsgi_server.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=replace-with-a-secure-random-secret-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000

# ============================================================================
# Storage & Model Paths
# ============================================================================
UPLOAD_FOLDER=uploads/raw
ANNOTATED_FOLDER=uploads/annotated
MODEL_WEIGHTS_PATH=models/weights/best.pt
MODEL_CONFIDENCE_THRESHOLD=0.25
